{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/workflow-architect/workflow.schema.json",
  "title": "Workflow Architect specification",
  "type": "object",
  "required": ["title", "domain", "version", "actors", "nodes", "edges"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "domain": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "actors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
    "phases": {"type": "array", "items": {"type": "object", "required": ["id", "label"]}},
    "process_areas": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "order": {"type": "integer"}}}},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "label", "owner"], "properties": {"id": {"type": "string"}, "type": {"enum": ["start", "end", "process", "decision", "subprocess", "manual_action", "external_system", "error"]}, "label": {"type": "string"}, "description": {"type": "string"}, "owner": {"type": "string"}, "phase": {"type": "string"}, "process_area": {"type": "string"}, "lane": {"type": "string"}, "layout_hint": {"type": "object", "properties": {"group": {"type": "string"}, "keep_together": {"type": "string"}, "preferred_direction": {"enum": ["right", "left", "up", "down"]}, "preferred_row": {"type": "integer", "minimum": 1, "maximum": 8}, "preferred_process_area": {"type": "string"}, "preferred_relative_position": {"type": "object", "properties": {"after": {"type": "string"}, "before": {"type": "string"}, "above": {"type": "string"}, "below": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false}}}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "label": {"type": "string"}, "path": {"enum": ["main", "alternative", "exception", "recovery"]}}}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "metadata": {
      "type": "object",
      "properties": {
        "outcome_classification": {
          "type": "object",
          "description": "Presentation-neutral semantic status by node ID. This classifies existing workflow nodes without changing graph logic.",
          "additionalProperties": {
            "enum": ["successful", "unsuccessful", "recoverable", "unclassified"]
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

